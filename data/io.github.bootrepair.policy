<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>BootRepair</vendor>
  <action id="io.github.bootrepair.analyze">
    <description>Analyse or repair a Windows installation</description>
    <description xml:lang="de">Eine Windows-Installation analysieren oder reparieren</description>
    <message>BootRepair needs administrator rights to read the disk (analysis is read-only) or to apply the repairs you selected</message>
    <message xml:lang="de">BootRepair benötigt Administratorrechte, um die Festplatte zu lesen (die Analyse verändert nichts) oder um die ausgewählten Reparaturen anzuwenden</message>
    <icon_name>io.github.bootrepair</icon_name>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/lib/bootrepair/bootrepair-helper</annotate>
  </action>
</policyconfig>
